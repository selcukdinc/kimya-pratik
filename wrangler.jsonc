{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kimya-pratik",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kimya-pratik",
			// `wrangler d1 create kimya-pratik` çıktısındaki database_id ile iki yerde değiştirin
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		},
		{
			"binding": "kimya_pratik",
			"database_name": "kimya-pratik",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"remote": true
		}
	],
	
	"routes": [{ "pattern": "kimya.selcukdinc.dev", "custom_domain": true }],
	"observability": {
		"enabled": false
	}
}